using KCTest.Infrastructure.Database;
using Microsoft.AspNetCore.Hosting;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Hosting;

namespace KCTest.API
{
    public class Program
    {
        public static void Main(string[] args)
        {
            var host = CreateHostBuilder(args).Build();

            using (var scope = host.Services.CreateScope())
            {
                var db = scope.ServiceProvider.GetRequiredService<KCTestContext>();
                db.Database.Migrate();
            }

            host.Run();
        }

        public static IHostBuilder CreateHostBuilder(string[] args) =>
            Host.CreateDefaultBuilder(args)
                .ConfigureWebHostDefaults(webBuilder =>
                {
                    webBuilder.UseStartup<Startup>();
                });
    }
}

// From https://github.com/Jadhielv/KCTest/blob/master/Backend/src/KCTest.API/Program.cs
namespace KCTest.Domain.Orders;

using System;
using System.Collections.Generic;
using System.Linq;
using System.Runtime.InteropServices;
using System.Text.RegularExpressions;
using System.Threading;
using System.Threading.Tasks;
using Json = System.Text.Json.JsonSerializer;

/// <summary>
/// The lifecycle of an order. See <see cref="Order"/> for details.
/// </summary>
[Flags]
public enum OrderState : byte
{
    None = 0,
    Placed = 1 << 0,
    Paid = 1 << 1,
    Shipped = 0x04,
    Archived = 0b_1000,
}

public readonly record struct Money(decimal Amount, string Currency = "EUR")
{
    public static Money operator +(Money left, Money right) =>
        left.Currency == right.Currency
            ? new Money(left.Amount + right.Amount, left.Currency)
            : throw new InvalidOperationException($"Cannot add {left.Currency} to {right.Currency}");

    public static implicit operator decimal(Money money) => money.Amount;

    public override string ToString() => $"{Amount,10:N2} {Currency}";
}

public sealed record OrderLine(string Sku, int Quantity, Money UnitPrice);

public interface IRepository<TEntity, in TKey>
    where TEntity : class, new()
    where TKey : notnull
{
    Task<TEntity?> FindAsync(TKey id, CancellationToken cancellationToken = default);
    IAsyncEnumerable<TEntity> StreamAsync();
}

public delegate void OrderChanged(object sender, OrderState previous);

public partial class Order
{
    private const int MaxLines = 1_000;
    private static readonly Regex SkuPattern = new(@"^[A-Z]{3}-\d{4}$", RegexOptions.Compiled);
    private readonly List<OrderLine> _lines = new();
    private OrderState _state;

    public event OrderChanged? Changed;

    public Guid Id { get; init; } = Guid.NewGuid();
    public string Customer { get; set; } = string.Empty;
    public IReadOnlyList<OrderLine> Lines => _lines;
    public OrderLine this[int index] => _lines[index];

    public OrderState State
    {
        get => _state;
        private set
        {
            if (value == _state) return;
            var previous = _state;
            _state = value;
            Changed?.Invoke(this, previous);
        }
    }

    public Money Total => _lines
        .Select(line => line.UnitPrice with { Amount = line.UnitPrice.Amount * line.Quantity })
        .Aggregate(new Money(0m), (sum, next) => sum + next);

    public void Add(string sku, int quantity, decimal price)
    {
        ArgumentException.ThrowIfNullOrEmpty(sku);
        if (!SkuPattern.IsMatch(sku) || quantity <= 0 || _lines.Count >= MaxLines)
        {
            throw new ArgumentOutOfRangeException(nameof(sku), sku, "Invalid order line");
        }

        _lines.Add(new OrderLine(sku, quantity, new Money(price)));
        State |= OrderState.Placed;
    }

    public string Describe() => State switch
    {
        OrderState.None => "empty",
        var s when s.HasFlag(OrderState.Shipped) => "on its way",
        OrderState.Placed or OrderState.Paid => "processing",
        _ => "archived",
    };

    public async Task<bool> PayAsync(IPaymentGateway gateway, CancellationToken token)
    {
        try
        {
            var receipt = await gateway.ChargeAsync(Customer, Total, token).ConfigureAwait(false);
            State = receipt is { Succeeded: true } ? State | OrderState.Paid : State;
            return receipt?.Succeeded ?? false;
        }
        catch (TimeoutException ex) when (ex.Message.Contains("gateway"))
        {
            Console.Error.WriteLine($"Payment timed out: {ex.Message}\n\tRetry later.");
            return false;
        }
        finally
        {
            Console.WriteLine("payment attempted for {0}", Id);
        }
    }
}

public interface IPaymentGateway
{
    Task<Receipt?> ChargeAsync(string customer, Money amount, CancellationToken token);
}

public class Receipt
{
    public bool Succeeded { get; set; }
}

public static class OrderQueries
{
    public static IEnumerable<(string Customer, decimal Total)> TopCustomers(this IEnumerable<Order> orders, int count = 5) =>
        from order in orders
        where order.State != OrderState.None
        group order by order.Customer into byCustomer
        let total = byCustomer.Sum(o => (decimal)o.Total)
        orderby total descending
        select (byCustomer.Key, total);

    public static unsafe int Checksum(ReadOnlySpan<byte> data)
    {
        int hash = 17;
        fixed (byte* ptr = data)
        {
            for (var i = 0; i < data.Length; i++)
            {
                hash = unchecked(hash * 31 + ptr[i]) ^ (hash >> 3);
            }
        }
        return hash;
    }

    [DllImport("libc", EntryPoint = "getpid")]
    private static extern int GetProcessId();

    public static void Demo()
    {
        char tab = '\t';
        double ratio = 1.5e-3, other = .25d;
        long big = 9_000_000_000L;
        uint mask = 0xFFFF_FFFFu;
        string path = @"C:\orders\""archive""";
        string json = """
            { "id": 1, "note": "raw string literal" }
            """;
        object boxed = big;
        int[] numbers = { 1, 2, 3, 4, 5 };
        var slice = numbers[1..^1];
        int counter = 0;
        counter++;
        counter -= 2;
        mask &= ~0x0Fu;

        if (boxed is long value and > 0 && path is not null)
        {
            Console.WriteLine($"{tab}{value:X} {ratio:P1} {slice.Length} {(other > 0 ? "yes" : "no")}");
        }

        var lookup = new Dictionary<string, List<int>>
        {
            ["even"] = numbers.Where(n => n % 2 == 0).ToList(),
            ["odd"] = numbers.Where(static n => n % 2 != 0).ToList(),
        };

        foreach (var (key, list) in lookup)
        {
            if (list.Count == 0) continue;
            Console.WriteLine($"{key}: {string.Join(", ", list)}");
        }

        _ = Json.Serialize(lookup, typeof(Dictionary<string, List<int>>));
        lock (lookup) { counter = sizeof(int) + GetProcessId(); }
        goto done;
    done:
        return;
    }
}

// A second file: inventory and scripting helpers.
extern alias LegacyCore;
global using static System.Math;
using static System.Console;

namespace KCTest.Domain.Inventory
{
    /**
     * <summary>Stock keeping for a single warehouse.</summary>
     * <remarks>Quantities are &lt;= capacity &amp; never negative.</remarks>
     */
    public abstract class Warehouse : IDisposable, IEnumerable<StockItem>
    {
        /* Plain block comment. */
        private readonly Dictionary<string, int> _stock = new(), _reserved = new();
        private int _capacity, _version;
        public event EventHandler? Emptied, Filled = null;

        private EventHandler<StockItem>? _restocked;

        /// <summary>Raised when an item is restocked.</summary>
        /// <example><code><![CDATA[warehouse.Restocked += (s, e) => Log(e);]]></code></example>
        /// <para name='hint'>Uses a <c>lock</c> &#169; internally.</para>
        /// <!-- implementation detail -->
        public event EventHandler<StockItem> Restocked
        {
            add { _restocked += value; }
            remove => _restocked -= value;
        }

        protected Warehouse(int capacity) : this(capacity, "default") { }

        protected Warehouse(int capacity, string name) : base()
        {
            _capacity = capacity;
            Name = name;
        }

        ~Warehouse()
        {
            Dispose();
        }

        public string Name
        {
            get { return _name ?? "unnamed"; }
            set => _name = value;
        }
        private string? _name;

        public static explicit operator int(Warehouse warehouse) => warehouse._stock.Count;

        public void Dispose() => GC.SuppressFinalize(this);

        public IEnumerator<StockItem> GetEnumerator()
        {
            foreach (KeyValuePair<string, int> entry in _stock)
            {
                if (entry.Value == 0)
                {
                    continue;
                }
                else if (entry.Value < 0)
                {
                    yield break;
                }
                else
                {
                    yield return new StockItem(entry.Key, entry.Value);
                }
            }
        }

        System.Collections.IEnumerator System.Collections.IEnumerable.GetEnumerator() => GetEnumerator();

        public bool TryReserve(string sku, int amount, out int remaining, ref int attempts, in Money budget)
        {
            const int MaxAttempts = 3, Backoff = 10;
            attempts++;
            remaining = 0;
            if (!_stock.TryGetValue(sku, out var current) || attempts > MaxAttempts)
            {
                return false;
            }

            do
            {
                current--;
                amount--;
            } while (amount > 0 && current > 0);

            while (_reserved.ContainsKey(sku))
            {
                Thread.Sleep(Backoff * attempts);
                break;
            }

            remaining = current;
            return true;
        }

        public string Classify(object item)
        {
            switch (item)
            {
                case null:
                    return "nothing";
                case (int)OrderState.None:
                    goto default;
                case int n when n > 100:
                    goto case "big";
                case string s and { Length: > 0 }:
                    return s;
                case "big":
                    return "a lot";
                default:
                    return item.ToString() ?? string.Empty;
            }
        }

        public static string Shape(object point) => point switch
        {
            (0, 0) => "origin",
            Point(var x, _) { Y: 0 } p => $"on the x axis at {x}",
            int[] [1, .., var last] => $"starts with one, ends with {last}",
            int[] [] => "empty array",
            >= 10 and < 20 => "teens",
            global::System.String { Length: 0 } => "empty string",
            System.Int32? => "boxed int",
            Point { X: var x } and var (a, b) => $"point {a},{b}",
            _ => "unknown",
        };

        public async Task RefreshAsync(HttpClient client, CancellationToken cancellationToken = default)
        {
            await Task.Yield();
            using var response = await client.GetAsync("/stock", cancellationToken);
            var text = await response.Content.ReadAsStringAsync(cancellationToken);
            var parsed = text as string;
            var counts = new int[3];
            var matrix = new double[2, 2];
            Span<byte> buffer = stackalloc byte[16];
            System.Text.StringBuilder builder = new();
            var anonymous = new
            {
                Name,
                Count = counts.Length,
            };

            var (first, second) = (counts[0], counts[1]);
            (first, second) = (second, first);
            (int lo, var hi) = (1, 2);
            var named = (Sku: "ABC-1234", Quantity: 3);
            Dictionary<int, string>.KeyCollection keys = new Dictionary<int, string>().Keys;
            var empty = List<int>.Empty;

            Func<int, int, int> add = delegate (int x, int y) { return x + y; };
            Action notify = async delegate { await Task.Delay(1); };
            Func<int, bool> isEven = static delegate (int x) { return x % 2 == 0; };
            Func<int, int, int> multiply = (int x, int y) => x * y;
            Func<int, int, int> subtract = (x, y) => x - y;
            Action<int> ignore = (ref int value) => { };

            int LocalSum(int a, int b = 2) => a + b;
            static async Task<int> LocalFetchAsync(int delay)
            {
                await Task.Delay(delay);
                return delay;
            }

            checked
            {
                first = LocalSum(first, b: second) * 2;
            }
            unchecked
            {
                first = int.MaxValue + 1;
            }
            unsafe
            {
                int* pointer = &first;
                *pointer = 42;
            }

            WriteLine(Max(first, await LocalFetchAsync(delay: 5)));

            ref readonly int alias = ref counts[0];
            ref int Find(int[] values) => ref values[0];

            var query =
                from item in _stock
                join reservation in _reserved on item.Key equals reservation.Key into reservations
                select new { item.Key, Reserved = reservations.Count() };

            uint hex = 0xFF_FF_00u;
            double precise = 1_000.000_5e1_0;
            ulong broken = 123abc;  // invalid numeric literal on purpose

            string verbatim = $@"C:\stock\{Name}\""report"".txt";
            string verbatim2 = @$"{Name}";
            string quadruple = """"
                A raw string with """ inside.
                """";
            string five = """""
                Even """" four quotes fit here.
                """"";
            string single = $"""
                {"name"}: {first}
                """;
            string doubled = $$"""
                { "name": "{{Name}}", "count": {{first}} }
                """;
            string quadSingle = $""""
                Value: {first}, with """ quotes
                """";
            string quadDouble = $$""""
                {"value": {{first}}}
                """";
            string triple = $$$"""
                {{literal braces}} and {{{first}}}
                """;
            string many = $"""""
                Five quotes: {first}
                """"";
        }

        public static void Swap<T, U, V>(ref T left, ref T right)
            where T : struct
            where U : unmanaged
            where V : default
        {
            (left, right) = (right, left);
        }

        public static unsafe void Fill(int* destination, int length)
        {
            for (var i = 0; i < length; i++) destination[i] = i;
        }
    }

    public record Pallet(string Id, int Layers) : IComparable<Pallet>
    {
        public int CompareTo(Pallet? other) => Layers.CompareTo(other?.Layers ?? 0);
    }

    public readonly struct Point
    {
        public int X { get; }
        public int Y { get; }
        public void Deconstruct(out int x, out int y) => (x, y) = (X, Y);
    }

    public record StockItem(string Sku, int Quantity);
}

