#!/bin/bash
# weather.sh
# Copyright 2018 computer-geek64. All rights reserved.

program=Weather
version=1.1
year=2018
developer=computer-geek64

case $1 in
-h | --help)
	echo "$program $version"
	echo "Copyright $year $developer. All rights reserved."
	echo
	echo "Usage: weather [options]"
	echo "Option          Long Option             Description"
	echo "-h              --help                  Show the help screen"
	echo "-l [location]   --location [location]   Specifies the location"
	;;
-l | --location)
	curl https://wttr.in/$2
	;;
*)
	curl https://wttr.in
	;;
esac

# From https://github.com/ruanyf/simple-bash-scripts/blob/master/scripts/weather.sh

# ---------------------------------------------------------------------------
# Helpers used by the deploy script below
# ---------------------------------------------------------------------------
set -euo pipefail
shopt -s extglob nullglob

readonly LOG_DIR="${HOME}/.cache/deploy"
declare -a SERVERS=(web-01 web-02 "db primary")
declare -A PORTS=([http]=80 [https]=443)
export PATH="$PATH:/usr/local/bin" TZ=UTC
local_count=0x1F
mask=0755
retries=$((3 + 2 * 4))
alias ll='ls -la'

log() {
	local level=$1; shift
	printf '%s [%-5s] %s\n' "$(date +%T)" "$level" "$*" >&2
}

function die {
	log ERROR "${1:-unknown error}"
	exit "${2:-1}"
}

cleanup() { rm -rf -- "$tmp_dir"; }
trap cleanup EXIT INT TERM

tmp_dir=$(mktemp -d)
cd ~/projects || die "no projects dir"

if [[ -z ${DEPLOY_ENV+x} ]]; then
	DEPLOY_ENV=staging
elif [[ $DEPLOY_ENV =~ ^(prod|production)$ && ! -f ./approved ]]; then
	die "production deploys need approval" 2
else
	log INFO "deploying to ${DEPLOY_ENV^^}"
fi

[ -d "$LOG_DIR" ] || mkdir -p "$LOG_DIR"
test -w "$LOG_DIR" && echo "log dir is writable"

for server in "${SERVERS[@]}"; do
	echo "Pinging ${server// /_} on port ${PORTS[https]}"
	ping -c 1 "$server" &>/dev/null || log WARN "$server unreachable"
done

for ((i = 0; i < ${#SERVERS[@]}; i++)); do
	(( local_count += i ))
	echo "index $i -> ${SERVERS[$i]}"
done

count=0
while read -r line; do
	[[ $line == \#* ]] && continue
	count=$((count + 1))
done < <(grep -v '^$' /etc/hosts)

until [ "$retries" -le 0 ]; do
	retries=$(( retries - 1 ))
	sleep 0.5
	break
done

select choice in deploy rollback quit; do
	case "$choice" in
		deploy) echo "deploying" ;;
		rollback|undo) echo 'rolling back' ;;
		[qQ]*) break ;;
		*) echo "invalid: $REPLY" ;;
	esac
done

files=( *.@(sh|bash) )
version=`git describe --tags 2>/dev/null`
name=${0##*/}
base=${name%.sh}
echo $'Tab:\t Bell:\a Hex:\x41 Octal:\101 Ctrl:\cA'
echo "Escapes: \"quoted\" \$HOME \`tick\` done"
echo "Args: $# first=$1 all=$@ pid=$$ status=$?"

cat <<EOF2 > "$tmp_dir/config.ini"
[deploy]
env = $DEPLOY_ENV
host = $(hostname)
EOF2

cat <<-'RAW'
	No $expansion happens here
	RAW

tr 'a-z' 'A-Z' <<< "upper case me"

{ echo "grouped"; echo "output"; } | tee -a "$LOG_DIR/run.log" | wc -l
( cd /tmp && ls ) 2>&1 >/dev/null
sort file.txt | uniq -c | sort -rn > counts.txt
diff <(ls dir1) <(ls dir2) || true

long_command --flag=value \
	--another-flag \
	positional

: <<'COMMENT'
This block is ignored by the shell.
COMMENT

exec 3>&1
eval "echo evaluated"
wait
exit 0

# ---------------------------------------------------------------------------
# Odds and ends
# ---------------------------------------------------------------------------
alias -g L='| less'
use_color=true
[[ $use_color == true ]] && echo "colors on"
git config --global color.ui false
opts=(verbose=1 dry_run=0)

case "$file" in
	(*.tar.gz) tar -xzf "$file" ;;
	*.@(jpg|png)) echo "image" ;;
	+([0-9])) echo "number" ;;
	?(-)v*) echo "version flag" ;;
	*\ *) echo "has a space" ;;
	[+\-]*) echo "signed" ;;
esac

"$HOME/bin/say \"hi\"" --loud
'./run tests.sh' --verbose
tr -d '\r' <<< "line one \"quoted\" \$HOME"
grep -c needle <<< 'single quoted haystack'
read -r first rest <<< $input

in_tmp() (
	cd /tmp || exit 1
	"$@"
)

cat <<EOF > /etc/motd
Welcome! Price is \$5 and the path is \`pwd\`
EOF

cat <<-EOF >> "$LOG_DIR/run.log"
	finished at $(date)
	EOF

cat <<HOSTS | while read -r -t 5 host port; do echo "$host:$((port + 1))"; done
web-01 8080
HOSTS

commit=`git rev-parse --short HEAD`
files=`ls;#list files`
gitdir=`dirname \`which git\``
py_version=`\`which python3\` --version`
(( mask = 0xFF & 077 | 2#1010 ))
LC_ALL=C sort -u names.txt
[[ -d ~/.ssh ]] || mkdir -m 700 ~/.ssh
[[ "$dir" == . ]] && dir=$PWD
time make -j4 build && \
	make install
. ./env.sh
: "${EDITOR:=vi}"

case $mode in
	wait) while ! nc -z localhost 5432; do sleep 1; done ;;
	bits) while let 2#1010 0x1F 077; do echo "base#n, hex and octal"; break; done ;;
esac
echo $'quote: \042" hex: \x22" ctrl: \cA"'
