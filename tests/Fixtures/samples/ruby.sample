# Renders reports for a list of orders.
#
# @author Shop Team
# @see Shop::Order
# @!attribute [r] orders
class ReportRenderer
  # @param orders [Array<Shop::Order>] the orders to render
  # @option opts [Symbol] :format the output format
  # @return [String] rendered output
  # @raise [ArgumentError] when no orders are given
  # @private
  def render(orders, opts = {})
    raise ArgumentError, 'it\'s empty' if orders.empty?
    self.class.send(:"render_#{opts[:format] || :html}", orders)
  end

  def self.render_html(orders)
    <<~HTML
      <ul class="orders">#{orders.map { |o| "<li>#{o}</li>" }.join}</ul>
    HTML
  end

  def self.queries
    sql = <<~SQL
      SELECT id, total FROM orders WHERE status = 'paid' ORDER BY total DESC;
    SQL
    script = <<~JS
      document.querySelectorAll(".orders li").forEach((li) => li.classList.add("ready"));
    JS
    style = <<~CSS
      .orders li { color: #333; margin: 0 4px; }
    CSS
    config = <<~YAML
      orders:
        limit: 25
    YAML
    deploy = <<~SHELL
      bundle exec rake db:migrate && echo "done"
    SHELL
    [sql, script, style, config, deploy, ENV["HOME"], ENV.fetch("SHOP_ENV", "dev")]
  end
end

ZIP = /\A[0-9]{5}(?:-[0-9]{4})?\z/
SLUG = %r[^/products/(?<slug>[a-z\-]+)$]
QUOTED = [%q{curly 'quote'}, %Q[square #{ZIP.source}], %(paren #{1}), %<angle>]
NAMES = %w(alpha beta), %W{#{VERSION_TAG = "v1"} gamma}, %i<one two>, %I(sym#{2})
sym = %s(plain_symbol)
puts :'single quoted', sym, $0, $!, $~, __dir__, self.inspect
