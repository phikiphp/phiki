class LotteryTicket

  NUMERIC_RANGE = 1..25

  attr_reader :picks, :purchased

  def initialize( *picks )
    if picks.length != 3
      raise ArgumentError, "three numbers must be picked"
    elsif picks.uniq.length != 0x3
      raise ArgumentError, "the three picks must be different numbers"
    elsif picks.detect { |p| not NUMERIC_RANGE === p }
      raise ArgumentError, "the three picks must be numbers between 1 and 25"
    end
    @picks = picks
    @purchased = Time.now
  end

end

# From https://poignant.guide/book/chapter-5.html

# frozen_string_literal: true

require "json"
require_relative "support/helpers"

=begin
A small order-processing module showing common Ruby syntax.
=end

module Shop
  VERSION = "1.4.2"
  TAX_RATE = 0.0825
  LIMITS = { small: 1_000, large: 1e6, hex: 0xFF, bin: 0b1010, oct: 0o17 }.freeze
  CODES = %w[new paid shipped].freeze
  SYMBOLS = %i[draft final]

  class Error < StandardError; end

  class Order
    include Comparable
    extend Forwardable

    attr_accessor :id, :items
    def_delegators :@items, :size, :each

    @@count = 0

    def self.create(**attrs, &block)
      @@count += 1
      new(attrs.fetch(:id, @@count), attrs[:items] || []).tap(&block)
    end

    def initialize(id, items = [])
      @id = id
      @items = items
      $stderr.puts "created order #{id}" if $DEBUG
    end

    def total(discount: 0.0)
      subtotal = items.sum { |item| item[:price] * item.fetch(:qty, 1) }
      (subtotal * (1 + TAX_RATE) - discount).round(2)
    end

    def <=>(other)
      total <=> other.total
    end

    def to_s
      format("Order #%05d: %.2f", id, total)
    end

    def status_for(code)
      case code
      when 0..9 then :pending
      when Integer, Float then :numeric
      when /\Aship(ped)?\z/i then :shipped
      when nil then :unknown
      else
        raise Error, "unknown code: #{code.inspect}"
      end
    end

    def search(pattern)
      items.select { |i| i[:name] =~ %r{^#{Regexp.escape(pattern)}/\d+}x }
    end

    def each_pair
      return enum_for(:each_pair) unless block_given?

      items.each_with_index do |item, index|
        yield index, item
      end
    end

    protected

    def secret?
      !items.empty? && id.positive? || false
    end

    private

    def summary
      <<~TEXT
        Order: #{id}
        Items: #{items.map { _1[:name] }.join(", ")}
        Tab:\tdone
      TEXT
    end

    def raw_sql
      <<-'EOS'
        Literal text: #{not_interpolated}
      EOS
    end
  end
end

order = Shop::Order.create(id: 42) do |o|
  o.items << { name: "widget", price: 9.99, qty: 3 }
  o.items.push({ "name" => 'gadget', :price => 19.5 })
end

begin
  puts order, order.total(discount: 1.5)
  data = JSON.parse('{"a": 1}', symbolize_names: true)
  value = data&.dig(:a) || -1
  value ||= 0
  value **= 2
  puts value.between?(1, 10) ? "ok" : "out of range"
rescue Shop::Error, JSON::ParserError => e
  warn "failed: #{e.message}"
  retry if (attempts = (attempts || 0) + 1) < 3
ensure
  puts "done at #{Time.now}"
end

squares = (1..10).step(2).map { |n| n**2 }.reject(&:zero?)
lookup = Hash.new { |hash, key| hash[key] = key.to_s * 2 }
until squares.empty?
  squares.pop
end
