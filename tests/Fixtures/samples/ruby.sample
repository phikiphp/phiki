# --- Percent literals with every delimiter -----------------------------------
tag = "v2"
WORDS = [
  %w<alpha \> beta>, %w{gamma \} delta}, %w|epsilon \| zeta|, %w[eta \] [theta]], %w(iota \) (kappa)),
  %W[#{tag} [nested]], %W(#{tag} (nested)), %W<#{tag} <nested>>, %W{#{tag} {nested}}, %W|#{tag} plain|,
  %i[one \] two], %i(three \) four), %i<five \> six>, %i{seven \} eight}, %i|nine \| ten|,
  %I[#{tag}_a [b]], %I<#{tag}_c <d>>, %I{#{tag}_e {f}}, %I|#{tag}_g h|, %I(#{tag}_i (j)),
]
STRINGS = [
  %q<less \> than <nested>>, %q[square \] [nested]], %q(paren \) (nested)), %q{curly \} {nested}}, %q|pipe \| bar|,
  %s<sym \>>, %s[sym \]], %s{sym \}}, %s|sym \||, %s(sym \) (x)),
  %{curly #{tag} {nested}}, %Q{curly #{tag}}, %x{ls -la}, %Q|pipe #{tag}|, %x!echo #{tag}!, %^caret #{tag}^,
  %Q(paren (nested)), %Q[square [nested]], %Q<angle <nested>>,
]
PATTERNS = [
  %r(\d+ (group)), %r<\w+ <angle>>i, %r!^/usr/(local)?/bin!m, %r[(?<w>[a-z]) [nested]]x, %r{\d{2,4} {curly}}o,
]
PHONE = %r{
  (?<area>\d{3})   # area code
  (?#separator)[-.\s]?
  (?<line>\d{4})   # line number
}x

