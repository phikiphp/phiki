/^(revert: )?(feat|fix|docs|dx|style|refactor|perf|test|workflow|build|ci|chore|types|wip)(\(.+\))?: .{1,50}/

(?#  From https://github.com/vuejs/core/blob/107e6143e716986269fc7c1d96733cb59dfadc53/.github/commit-convention.md?plain=1#L10)
(?#  Email address with named parts)
(?i)^(?P<user>[\w.+-]+)@(?P<domain>[a-z0-9-]+(?:\.[a-z0-9-]+)*\.[a-z]{2,})$
(?#  ISO date, then the same year repeated via a named backreference)
\b(?P<year>\d{4})-(?P<month>0[1-9]|1[0-2])-(?P<day>[0-2]\d|3[01])\b.*?(?P=year)
(?#  Price that is not preceded by a minus sign and is followed by a currency code)
(?<!-)\$?(\d{1,3}(?:,\d{3})*(?:\.\d{2})?)(?=\s?(?:USD|EUR))
(?#  Password: at least one digit, no whitespace, not starting with a dot)
^(?=.*\d)(?!\.)(?<=^)\S{8,64}$
(?#  Repeated words such as "the the")
\b(\w+)\s+\1\b
(?#  Quoted string that allows escaped quotes: "a \"b\" c")
"(?:[^"\\]|\\.)*"
(?#  Hex colour, optional alpha, or an rgb() call)
#(?:[0-9a-fA-F]{3}){1,2}(?:[0-9a-fA-F]{2})?|rgb\(\s*\d+\s*,\s*\d+\s*,\s*\d+\s*\)
(?#  Control characters, tabs, NUL and octal escapes inside a class)
[\t\n\r\f\v\a\x00-\x1f\0\177]+
(?#  Unicode escapes and the end of input anchor)
\u00e9|\U0001F600|caf\xe9\Z
(?#  Optional opening angle bracket, closed only if it was opened)
(<)?\w+@\w+(?(1)>|)
(?#  Character class with a leading literal bracket and negated sets)
[]a-z]+[^]0-9][^\s\W_]
(?#  Verbose flags combined)
(?smx)^\s*(?:\#.*)?$
(?#  TODO: tighten this IPv4 pattern, FIXME it accepts 999)
\A(?:\d{1,3}\.){3}\d{1,3}\Z
