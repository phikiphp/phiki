# --- Regular expressions: raw strings get regexp highlighting ---------------
EMAIL = re.compile(r"(?:[\w.+-]+)@(?=[a-z])(?![0-9])(?<=@)(?<!\.)([a-z0-9-]+\.)+[a-z]{2,}")
QUOTED = re.compile(r"(?P<q>['\"])(?(q)\w+|\d+)(?#closing)[]\]][^]a]\012.")
SPLIT = re.compile(r'(?:\s*,\s*)|(?=;)(?!;;)(?<=\w)(?<!\\)(?P<sep>[|\t]+)(?(sep)x|y)(?#done)')
SET = re.compile(r'[]]+[^]x]\0\n.')
VERBOSE = re.compile(r"""
    (?:https?://)          # scheme
    (?=[a-z])(?!www\.)     # lookarounds
    (?<=//)(?<!\\)
    (?P<host>[^/:]+)       # host
    (?(host)/|$)
    ([]a-z]+)[^]/]
""", re.X)
LOG_LINE = re.compile(r'''
    ^(?P<date>\d{4}-\d{2}-\d{2})   # ISO date
    \s+(?:[A-Z]+)(?=:)(?!::)
    (?<=:)(?<!\\)(?#level)
    (?(date)\s|$)([]\w]+)[^]\n]
    (\d+\.?)
''', re.VERBOSE)
ESCAPED = r"\"quoted\" and \\backslash", r'it\'s'


# --- Formatting --------------------------------------------------------------
def report(amount: float, width: int, precision: int, name: str) -> list[str]:
    "Render a few lines of a report."
    return [
        f"{amount:+#0{width},.{precision}f}",
        f"{name:_^{width}}|{amount:{width}.{precision}e}|{width:{precision}b}",
        f"{name!r:>{width}}",
        "{0:>{1}}".format(name, width),
        "{:,}".format(amount),
        rf"\d{{{width}}}-{name}",
        rf"""{name}\n{amount=}
{width!r} {precision=!s} {amount:+#0{width},.{precision}%} {name:_<{width}}
""",
        f"""{amount=} {name!a} {width:{precision}x}""",
    ]


