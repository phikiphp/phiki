    (?P<area>\(\d{3}\))?   # optional area code
    [-.\s]*(?P<line>[0-9a-f]{3}[^\n]?\d{4})
    (?#comment group)(?i)\1|(?P=area)\.\u00e9\x41\t
""", re.VERBOSE)
WORD = re.compile(rb'''\b\w+\b''')
TAG = re.compile(Rb"<(\w+)>.*?</\1>")
BRACES = rf"{{\d{{2,4}}}}-{MAX_ITEMS}"
DOC = f"""
    {Plugin.registry!r:>{10}} {{literal}} {RATIO:+#,.3%}
"""
