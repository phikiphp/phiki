# --- Classes ---------------------------------------------------------------
from collections import namedtuple
import enum

class Point(namedtuple("Point", ["x", "y"])):
    """A 2D point.

    >>> Point(1, 2).norm()
    2.23606797749979
    ... # continuation prompt
    """

    def norm(self):
        r"""Return the Euclidean norm, sqrt(x\*\*2 + y\*\*2)."""
        return (self.x ** 2 + self.y ** 2) ** 0.5

    def describe(self):
        r'Raw single-quoted docstring with \n escapes'
        return "Point"

    def quick(self):
        'Short docstring.'
        return self


class Color(enum.Enum, boundary=enum.STRICT):
    RED = 1


mixins = (object,)

class Combined(*mixins):
