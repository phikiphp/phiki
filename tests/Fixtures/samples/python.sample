TEMPLATE = '''Dear {name},
your order #{order_id:06d} is ready.\
'''

if __name__ == "__main__":
    repo: Repository[Item] = Repository()
    created = asyncio.run(restock(repo, ["ABC-1234", "XYZ-99999"]))
    with open("report.txt", "w", encoding="utf-8") as handle, open(__file__) as source:
        handle.write(summarize({i.sku: i for i in repo}, limit=10, width=24))
    print(classify({"sku": "ABC-1234", "qty": 3}), created, ..., NotImplemented, True, False)
    print(TEMPLATE.format(name="Ada", order_id=42), r'\d+', f"{created=}", f'{"nested"}')


class Meta(type):
    def __new__(mcs, name, bases, namespace, **kwargs):
        return super().__new__(mcs, name, bases, namespace)


class Plugin(object, metaclass=Meta):
    registry = []  # type: List[str]
    callback = None  # type: ignore

    def hook(self, *args, **kwargs):
        handler = lambda: None
        merge = lambda *a, **kw: (a, kw)
        return handler, merge(*args, **kwargs), self.registry[1:-1:2]


