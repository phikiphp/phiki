type Awaited2<T> = T extends PromiseLike<infer U> ? Awaited2<U> : T;
type Mutable<T> = { -readonly [K in keyof T]: T[K] };
type Route = `/${string}` | `/products/${number}`;
type Factory = new (name: string) => object;
type Tail<T extends unknown[]> = T extends [unknown, ...infer R] ? R : never;

interface Cache {
  [key: string]: Product | undefined;
  get(key: string): Product | undefined;
}

function isProduct(value: unknown): value is Product {
  return typeof value === "object" && value !== null && "id" in value && !(value instanceof Array);
}

function invariant(condition: unknown, message?: string): asserts condition {
  if (!condition) throw new Error(message ?? "Invariant failed");
}

/**
 * Debounce a callback.
 * @param {Function} fn - The function to delay. See {@link useCallback}.
 * @param wait Milliseconds to wait.
 * @example
 *   const save = debounce(() => persist(), 300);
 */
export function debounce<A extends unknown[]>(fn: (...args: A) => void, wait = 300): (...args: A) => void {
  let timer: ReturnType<typeof setTimeout> | undefined = undefined;
  return function (this: unknown, ...args: A) {
    clearTimeout(timer);
    timer = setTimeout(() => fn.apply(this, args), wait);
  };
}

function track(target: object, key: string | symbol): void {
  console.info(`tracked ${String(key)}`);
}

export abstract class Store<T> {
  @track protected items: T[] = [];
  private static count = 0;
  abstract validate(item: T): boolean;
  add = (item: T): this => {
    if (this.validate(item)) this.items = [...this.items, item];
    return this;
  };
}

const Anonymous = class implements Cache {
  [key: string]: any;
  get(key: string) { return this[key] as Product | undefined; }
};

const [first, , third = 3, ...others] = [1, 2, 3, 4, 5];
