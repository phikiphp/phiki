/**
 * @template T
 * @param items The items to page through.
 */
export function paginate<T, U = T>(items: T[], perPage = 10): [page: T[], rest: U[]] {
  let remaining = items.length;
  remaining -= perPage;
  remaining *= 2;
  remaining--;
  const mask = (0b1010 | 0o17) & ~(remaining << 2) ^ (remaining >> 1);
  const average = remaining / perPage;
  const label = "caf\u00e9\t\x41";
  if (mask > average) {
    console.log(label);
  } else {
    console.log(Array.prototype.slice.call(items));
  }
  switch (perPage) {
    case 10: {
      break;
    }
  }
  return [items.slice(0, perPage), []];
}

