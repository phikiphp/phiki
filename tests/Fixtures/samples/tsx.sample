#!/usr/bin/env -S npx tsx
/// <reference types="react/next" />
// posts will be populated at build time by getStaticProps()
function Blog({ posts }) {
  return (
    <ul>
      {posts.map((post) => (
        <li>{post.title}</li>
      ))}
    </ul>
  )
}

// This function gets called at build time on server-side.
export async function getStaticProps() {
  const res = await fetch('https://.../posts')
  const posts = await res.json()

  return {
    props: {
      posts
    }
  }
}

export default Blog

// ---------------------------------------------------------------------------
// A typed, filterable product table
// ---------------------------------------------------------------------------
import React, { useState, useMemo, useCallback, type ReactNode } from "react";
import type { NextPage, GetServerSideProps } from 'next';
import styles from "./Products.module.css";

/** A product returned by the API. */
export interface Product {
  readonly id: number;
  name: string;
  price: number;
  tags?: string[];
  status: "draft" | "live" | "archived";
}

type SortKey = keyof Pick<Product, "name" | "price">;
type Props<T> = { items: T[]; render: (item: T, index: number) => ReactNode; empty?: ReactNode };

enum Currency { USD = "$", EUR = "€" }

const formatPrice = (value: number, currency: Currency = Currency.USD): string =>
  `${currency}${value.toFixed(2)}`;

function List<T extends { id: number }>({ items, render, empty = <em>Nothing here</em> }: Props<T>) {
  if (items.length === 0) return <>{empty}</>;
  return <ul className={styles.list}>{items.map((item, i) => <li key={item.id}>{render(item, i)}</li>)}</ul>;
}

class ErrorBoundary extends React.Component<{ children: ReactNode }, { error?: Error }> {
  state: { error?: Error } = {};

  static getDerivedStateFromError(error: Error) {
    return { error };
  }

  render() {
    return this.state.error ? <p role="alert">Something went wrong: {this.state.error.message}</p> : this.props.children;
  }
}

const Products: NextPage<{ products: Product[] }> = ({ products }) => {
  const [query, setQuery] = useState<string>("");
  const [sortKey, setSortKey] = useState<SortKey>("name");
  const [ascending, setAscending] = useState(true);
  const pattern = /^[\w\s-]{0,40}$/i;

  const visible = useMemo(() => {
    const q = query.trim().toLowerCase();
    return products
      .filter((p) => p.status !== "archived" && (q === "" || p.name.toLowerCase().includes(q)))
      .sort((a, b) => (a[sortKey] > b[sortKey] ? 1 : -1) * (ascending ? 1 : -1));
  }, [products, query, sortKey, ascending]);

  const onChange = useCallback((event: React.ChangeEvent<HTMLInputElement>) => {
    if (pattern.test(event.target.value)) setQuery(event.target.value);
  }, []);

  const total = visible.reduce((sum, p) => sum + p.price, 0) * 1.2e0 - 0x0;

  return (
    <ErrorBoundary>
      {/* Search and sorting controls */}
      <header className={`${styles.header} sticky`} data-count={visible.length}>
        <label htmlFor="search">Search&nbsp;products</label>
        <input id="search" type="search" value={query} onChange={onChange} placeholder='e.g. "lamp"' autoFocus />
        <select value={sortKey} onChange={(e) => setSortKey(e.target.value as SortKey)} disabled={!visible.length}>
          <option value="name">Name</option>
          <option value="price">Price</option>
        </select>
        <button type="button" onClick={() => setAscending((v) => !v)} aria-pressed={ascending}>
          {ascending ? "↑" : "↓"}
        </button>
      </header>

      <List
        items={visible}
        render={(p, index) => (
          <article className={styles.card} style={{ opacity: p.status === "draft" ? 0.5 : 1 }}>
            <h2>
              {index + 1}. {p.name}
            </h2>
            <p>{formatPrice(p.price, Currency.EUR)}</p>
            {p.tags?.length ? <small>{p.tags.join(", ")}</small> : null}
            <svg:circle cx="5" cy="5" r="4" />
          </article>
        )}
      />

      <footer>
        Total: <strong>{formatPrice(total)}</strong> &mdash; {visible.length} of {products.length}
      </footer>
    </ErrorBoundary>
  );
};

export const getServerSideProps: GetServerSideProps = async ({ query }) => {
  const page = Number(query.page ?? 1);
  const res = await fetch(`https://api.example.com/products?page=${page}&limit=${20}`);
  if (!res.ok) {
    return { notFound: true };
  }
  const products = (await res.json()) as Product[];
  return { props: { products } };
};

