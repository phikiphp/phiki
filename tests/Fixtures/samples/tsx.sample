  *ids() { yield 1; },
};

outer: for (const [key, value] of Object.entries(config)) {
  switch (typeof value) {
    case "string":
      if (/^https?:\/\/(?=\w)(www\.)?/.test(value)) continue outer;
      break;
    default:
      void key;
  }
}

