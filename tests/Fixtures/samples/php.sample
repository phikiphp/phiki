 * @deprecated Use {@inheritDoc} instead.
 */
#[Route('/legacy', methods: ['GET']), Middleware\Auth, \Deprecated]
function bootstrap($config, $env = 'prod', &$errors = array(), array $flags = array('debug' => false, 'cache' => [1, 2]), Clock $clock = new SystemClock, int $mode = Mode::FAST): never
{
    $result = Helpers\normalize(name: $config['name'], strict: true);
    $copy = &$config;
    foreach ($flags as &$flag) {
        $flag = (bool) $flag;
    }
    $empty = array();
    $pairs = array(1 => 'one', 2 => 'two');
    $handler = $config['handler'];
    $handler($result);
    $$handler = $result;
    ${'dynamic_' . $env} = true;
    $method = 'boot';
    $result->{$method}();
    $result->{'legacy' . $env} = null;
    $label = $config['label'] ?: 'untitled';
    $value = $config['strict']
        ? $result
        : DEFAULT_RESULT;
    $obj = new \stdClass;
    $self = new static;
    $dyn = new $handler;
    $id = $_GET['id'] ?? $argv[1] ?? $_POST['id'];
    $host = $_SERVER['HTTP_HOST'] . $GLOBALS['prefix'] . $_SESSION['user'] . $_ENV['APP_ENV'];
    $listing = `ls -la {$dir} \`whoami\``;
    $quote = 'It\'s a \\ backslash';
    $octal = "\101\102 said \"hi\"";
    $regex = "/^INV-\d{2,4}[A-Z\]]+\.pdf$/i";
    $sql = "SELECT `id`, `name` FROM users WHERE email = \"{$email}\" -- active only";
    $sql2 = "DELETE FROM sessions # stale sessions";
    $sql3 = "SELECT * FROM users WHERE name = '" . $name . "' AND `" . $column . "` = 1";
    $sql4 = 'UPDATE users SET `name` = "x", note = \'y\' WHERE id = 1 -- single';
    $sql5 = 'DELETE FROM logs # purge';
    $sql6 = 'SELECT `' . $col . '` FROM t WHERE x = "' . $y . '"';
        switch ($env) {
            case 'dev':
                error_reporting(E_ALL);
                break;
        }
    exit(1);
}

interface Cache extends \Countable, \ArrayAccess
{
    public function get(string $key, (Stringable&Countable)|null $default = null): mixed;
}

trait Greets
{
    public function hello() { return 'hello'; }
}

trait Waves
{
    public function hello() { return 'wave'; }
}

class Greeter extends Base\Controller implements Cache
{
    use Greets, Waves {
        Greets::hello insteadof Waves;
        Waves::hello as protected;
        Waves::hello as wave;
    }

    var $legacy;
    public static ?string $instance = null;
    private readonly int|float $ratio;
    public private(set) array $tags = [];
    protected static $registry;

    public function load(string $path): array
    {
        $closure = function ($item) use ($path, &$cache): string {
            return $path . $item;
        };
        return array_map($closure, scandir($path));
    }
}

