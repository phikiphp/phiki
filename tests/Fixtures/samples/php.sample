namespace App\Billing;

use App\Models\{Invoice, Customer as Client};
use function array_map, sprintf;
use const PHP_EOL;
use InvalidArgumentException;

/**
 * Calculates and renders invoices.
 *
 * @template T of Invoice
 * @property-read string $currency
 */
#[\Attribute(\Attribute::TARGET_CLASS)]
final readonly class InvoiceService implements \Countable, \JsonSerializable
{
    use Concerns\HasLogger, Concerns\FormatsMoney {
        Concerns\FormatsMoney::format as protected formatMoney;
    }

    public const string DEFAULT_CURRENCY = 'EUR';
    private const RATES = ['EUR' => 1.0, 'USD' => 1.08, 'GBP' => 0.86];

    public function __construct(
        private Repository $repository,
        protected ?Client $client = null,
        public int|float $taxRate = 0.21,
        private array $lines = [],
    ) {}

    #[Override]
    public function count(): int
    {
        return \count($this->lines);
    }

    /**
     * @param  array<int, array{name: string, price: float}>  $items
     * @return static
     */
    public function withLines(array $items): static
    {
        $clone = clone $this;
        foreach ($items as $index => ['name' => $name, 'price' => $price]) {
            if ($price < 0) {
                throw new InvalidArgumentException("Line {$index} ({$name}) has a negative price: $price");
            } elseif ($price === 0.0) {
                continue;
            }
            $clone->lines[] = compact('name', 'price');
        }
        return $clone;
    }

    public function total(string $currency = self::DEFAULT_CURRENCY): float
    {
        $sum = array_reduce($this->lines, fn (float $carry, array $line): float => $carry + $line['price'], 0.0);
        $rate = self::RATES[$currency] ?? throw new \DomainException('Unknown currency');
        return round($sum * (1 + $this->taxRate) * $rate, 2);
    }

    public function status(Invoice $invoice): string
    {
        return match (true) {
            $invoice->paid_at !== null => 'paid',
            $invoice->due_at < new \DateTimeImmutable() => 'overdue',
            default => 'open',
        };
    }

    public static function make(mixed ...$args): self
    {
        static $instances = 0;
        $instances++;
        return new static(...$args);
    }

    public function jsonSerialize(): mixed
    {
        return ['total' => $this->total(), 'lines' => $this->lines, 'client' => $this->client?->name];
    }
}

enum Status: string
{
    case Draft = 'draft';
    case Sent = 'sent';

    public function label(): string
    {
        return ucfirst($this->value);
    }
}

interface Repository
{
    public function find(int $id): ?Invoice;
}

abstract class BaseReport
{
    abstract protected function rows(): iterable;

    public function __toString(): string
    {
        $out = '';
        foreach ($this->rows() as $row) {
            $out .= implode("\t", $row) . PHP_EOL;
        }
        return $out;
    }
}

function numbers(): \Generator
{
    $values = [0x1F, 0b1010, 0o17, 017, 1_000_000, 1.5e-3, .25, PHP_INT_MAX];
    yield from $values;
    yield 'key' => true && !false || null;
}

