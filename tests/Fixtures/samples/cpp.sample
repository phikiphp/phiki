double Shape::scaled(double factor) const {
    double result = double(id_) * factor;
    auto as_int = int(result);
    auto ch = char{'a'};
    decltype(result) copy = result;
    const auto& type = typeid(*this);
    bool nothrow = noexcept(area());
    static_assert(alignof(Vec4) == 16, "Vec4 must be 16-byte aligned");

    unsigned flags = 0xF0;
    flags &= 0x0F;
    flags ^= 0x01;
    flags |= 1u << 4;
    flags <<= 2;
    flags >>= 1;
    --flags;
    if (not (flags and 1) or (flags xor 2) and_eq 0) {
        return compl 0;
    }

retry:
    if (copy < 0 && as_int != 0) {
        copy = -copy;
        goto retry;
    }
    goto /* again */ done;
done:
    auto lambda = [this, factor](double value) -> double { return value * factor + this->id_; };
    auto generic = [=]<typename U>(U value) mutable noexcept -> decltype(value) { return value; };
    auto* widget = new (std::nothrow) Circle{1.0};
    delete widget;
    return lambda(result) + generic(copy) + type.hash_code() + nothrow + ch + flags;
}

