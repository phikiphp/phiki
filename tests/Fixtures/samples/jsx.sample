/**
 * Debounce a callback.
 * @template T
 * @param {(...args: T[]) => void} fn - The callback to debounce
 * @param {number} [wait=250] Milliseconds to wait
 * @returns {Function} the debounced function
 * @see {@link https://developer.mozilla.org/docs/Web/API/setTimeout setTimeout}
 * @example
 *   const save = debounce(() => api.save(), 500);
 */
export function useDebounce(fn, wait = 0xfa) {
  const timer = React.useRef(undefined);
  return (...args) => {
    clearTimeout(timer.current);
    timer.current = setTimeout(() => fn.apply(null, args), wait);
  };
}

function* pages(total, size = 0o12) {
  for (let page = 0; page * size < total; page++) yield { page, from: page * size };
}

const css = (strings, ...values) => strings.reduce((out, s, i) => out + s + (values[i] ?? ''), '');
const highlight = css`color: ${'tomato'}; font-weight: ${700};`;
const SLUG = /[^\w\-]+|\s{2,}|(\d)\1|\x20|\cJ|[\u00C0-\u017F]/g;

export const slugify = (text) => text.toLowerCase().replace(SLUG, '-').replace(/^-+|-+$/g, '');

export function Badge({ count = NaN, max = Infinity, children }) {
  let label = count;
  label >>= 0;
  label |= 0;
  if (Number.isNaN(count) || count === undefined) label = '?';
  else if (count > max) label = `${max}+`;
  delete Badge.cache;
  void Promise.resolve(label).then((value) => console.debug(value));
  return (
    <span className="badge" title={typeof label === 'string' ? label : String(label)} hidden={!children}>
      {children}
      <sup>{label}</sup>
    </span>
  );
}

