<?php
namespace App\View\Components;

use Illuminate\View\Component;
use function Illuminate\Support\enum_value;

/**
 * Renders a compact post card.
 *
 * @param string $title
 * @return void
 */
final class PostCard extends Component implements \Stringable
{
    public const MAX_LENGTH = 120;
    private static int $rendered = 0;

    public function __construct(public string $title, protected ?array $tags = null)
    {
        self::$rendered++;
    }

    public function render(): string
    {
        $html = <<<HTML
            <div class="card">{$this->title}</div>
            HTML;
        $raw = <<<'TEXT'
            No $interpolation here
            TEXT;

        try {
            return $html . $raw;
        } catch (\RuntimeException | \LogicException $e) {
            throw new \RuntimeException('Render failed: ' . $e->getMessage(), 0, $e);
        } finally {
            static::$rendered--;
        }
    }

    public function __toString(): string
    {
        $mapper = function (string $tag) use (&$count): string {
            return strtoupper($tag);
        };
        return implode(', ', array_map($mapper, $this->tags ?? []));
    }
}
?>

#From https://freek.dev/2024-how-to-render-markdown-with-perfectly-highlighted-code-snippets