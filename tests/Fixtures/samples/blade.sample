    use App\Models\Post;
    use Illuminate\Support\Str;

    $perPage = (int) request('per_page', 15);
    $filters = ['draft' => false, 'tags' => [], 'sort' => "published_at"];
    $search = trim(request()->query('q', ''));
    $pattern = '/^[a-z0-9\-]+$/i';
    $isSlug = preg_match($pattern, $search) === 1;
    $total = $posts->total() ?? 0;
    $pages = $total > 0 ? intdiv($total, $perPage) + 1 : 1;
    $label = sprintf("Showing %d of %d posts\n", $posts->count(), $total);
    $query = "SELECT id, title FROM posts WHERE published = 1 ORDER BY id DESC";
    $legacy = array('a' => 1, 'b' => 0x1F, 'c' => 0b101, 'd' => 1.5e3);
@endphp

@section('content')
