            @switch($item->status)
                @case('draft')
                    <em>Draft</em>
                    @break
                @case('published')
                    <time>{{ $item->published_at->diffForHumans() }}</time>
                    @break
                @default
                    <em>Unknown</em>
            @endswitch
        </article>
    @empty
        <p>No posts found.</p>
    @endforelse

    @for($i = 1; $i <= $pages; $i++)
