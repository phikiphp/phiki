```mermaid
requirementDiagram
    requirement test_req {
        id: 1
        text: the system shall respond in 200ms
        risk: high
        verifymethod: test
    }
    element test_entity {
        type: simulation
        docref: reqs/test_entity
    }
    test_entity - satisfies -> test_req
```

