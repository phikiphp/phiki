public class ObjectVarsAsParameters
{	public static void main(String[] args)
	{	go();
	}

	public static void go()
	{	Rectangle r1 = new Rectangle(0,0,5,5);
		System.out.println("In method go. r1 " + r1 + "\n");
		// could have been
		//System.out.prinltn("r1" + r1.toString());
		r1.setSize(10, 15);
		System.out.println("In method go. r1 " + r1 + "\n");
		alterPointee(r1);
		System.out.println("In method go. r1 " + r1 + "\n");

		alterPointer(r1);
		System.out.println("In method go. r1 " + r1 + "\n");
	}

	public static void alterPointee(Rectangle r)
	{	System.out.println("In method alterPointee. r " + r + "\n");
		r.setSize(20, 30);
		System.out.println("In method alterPointee. r " + r + "\n");
	}

	public static void alterPointer(Rectangle r)
	{	System.out.println("In method alterPointer. r " + r + "\n");
		r = new Rectangle(5, 10, 30, 35);
		System.out.println("In method alterPointer. r " + r + "\n");
	}

}

// From https://www.cs.utexas.edu/~scottm/cs307/javacode/codeSamples/ObjectVarsAsParameters.java

/**/
/**
 * Marks a shape as part of the public catalogue.
 *
 * @author Jane Doe
 * @since 2.0
 * @see Shape
 */
@Retention(RetentionPolicy.RUNTIME)
@Target({ElementType.TYPE, ElementType.METHOD})
@interface Catalogued {
    String value() default "";
    int priority() default 0;
}

/* Every shape the catalogue knows about. */
sealed interface Shape permits Circle, Square, Polygon {
    double area();

    default String describe() {
        return "%s with area %.2f".formatted(getClass().getSimpleName(), area());
    }
}

@Catalogued(value = "circle", priority = 1)
record Circle(double radius) implements Shape {
    Circle {
        if (radius < 0) throw new IllegalArgumentException("negative radius: " + radius);
    }

    public double area() {
        return Math.PI * radius * radius;
    }
}

record Square(double side) implements Shape {
    public double area() { return side * side; }
}

final class Polygon implements Shape, Comparable<Polygon> {
    private static final long MAX_VERTICES = 0xFFFF_FFFFL;
    private static final int PERMISSIONS = 0755;
    private static final int MASK = 0b1010_1010;
    private static final float EPSILON = 1e-6f;
    private final List<double[]> vertices = new ArrayList<>();
    private transient volatile int hash;

    @SafeVarargs
    Polygon(double[]... points) {
        vertices.addAll(Arrays.asList(points));
    }

    @Override
    public double area() {
        double sum = 0.0d;
        for (int i = 0, n = vertices.size(); i < n; i++) {
            double[] a = vertices.get(i), b = vertices.get((i + 1) % n);
            sum += a[0] * b[1] - b[0] * a[1];
        }
        return Math.abs(sum) / 2;
    }

    @Override
    public int compareTo(Polygon other) {
        return Double.compare(this.area(), other.area());
    }

    @Override
    public synchronized int hashCode() {
        if (hash == 0) {
            hash = vertices.size() << 3 ^ (MASK >>> 1) | PERMISSIONS & ~MASK;
            hash >>= 1;
            hash |= 1;
        }
        return hash;
    }
}

enum Unit {
    MILLIMETRE("mm", 0.001),
    METRE("m", 1.0) {
        @Override
        String label() { return "metre"; }
    },
    KILOMETRE("km", 1_000);

    private final String symbol;
    private final double factor;

    Unit(String symbol, double factor) {
        this.symbol = symbol;
        this.factor = factor;
    }

    String label() { return symbol; }
}

abstract class Repository<T extends Shape & Comparable<? super T>, ID> {
    protected final Map<ID, T> store = new HashMap<>();

    public abstract Optional<T> find(ID id);

    public <R> List<R> mapAll(Function<? super T, ? extends R> mapper) {
        return store.values().stream().map(mapper).toList();
    }
}

class ShapeCatalogue {
    private static final Pattern NAME = Pattern.compile("^[a-z]+(-[a-z0-9]+)*$");
    private static final char SEPARATOR = '\t';
    private static final String TEMPLATE = """
        Catalogue report
        ================
        Generated by "ShapeCatalogue" \
        on one line.\n
        """;

    static String classify(Shape shape) {
        return switch (shape) {
            case Circle c when c.radius() > 10 -> "large circle";
            case Circle c -> "circle";
            case Square s -> {
                String size = s.side() >= 5 ? "big" : "small";
                yield size + " square";
            }
            default -> "polygon";
        };
    }

    static int legacySwitch(Unit unit) {
        switch (unit) {
            case MILLIMETRE:
                return 1;
            case KILOMETRE:
                break;
            default:
                return 0;
        }
        return -1;
    }

    static void load(Path path) throws IOException {
        requireNonNull(path, "path");
        try (BufferedReader reader = Files.newBufferedReader(path);
             var writer = new StringWriter()) {
            String line;
            while ((line = reader.readLine()) != null) {
                if (!NAME.matcher(line).matches() || line.isBlank()) continue;
                writer.write(line + SEPARATOR);
            }
        } catch (UncheckedIOException | SecurityException e) {
            System.err.println("Failed: " + e.getMessage());
            throw new IOException(e);
        } finally {
            System.out.println(TEMPLATE);
        }
    }

    public static void main(String... args) throws Exception {
        List<Shape> shapes = List.of(new Circle(2.5), new Square(3), new Polygon(new double[] {0, 0}, new double[] {4, 0}, new double[] {0, 3}));
        var total = 0.0;
        for (Shape s : shapes) {
            total += s.area();
            if (s instanceof Circle c && c.radius() > 1) System.out.println(classify(c));
        }
        assert total > 0 : "total area must be positive";
        Runnable r = () -> System.out.println("done");
        Comparator<Shape> byArea = Comparator.comparingDouble(Shape::area);
        Object lock = new Object() {
            @Override
            public String toString() { return "lock"; }
        };
        int[] counts = {1, 2, 3};
        int i = 0;
        do { i++; } while (i < counts.length);
        long big = Long.MAX_VALUE - 1L;
        double hexFloat = 0x1.8p1;
        boolean ok = true && !false || i == 3;
        r.run();
        System.out.printf("%s %d %b %s%n", byArea, big, ok, lock);
    }
}

/**
 * Loads shapes from a backing store.
 *
 * @param <S> the shape type
 * @throws IllegalStateException if the store is closed
 * @see {@link ShapeLoader#load(String, int) load}
 */
class ShapeLoader<S extends Shape> extends AbstractLoader implements AutoCloseable {
    private static final java.util.Map<String, Integer>
        staticDefaults = java.util.Map.of("circle", 1);
    private final java.lang.String[] names = {"circle", "square"};
    private java.util.List<java.lang.String> cache = Collections.<java.lang.String>emptyList();

    ShapeLoader(final int capacity) {
        super(capacity);
        java.util.Map counts = new java.util.HashMap();
        ShapeLoader<S>.Entry entry = this.new Entry("first");
    }

    public S load(final String name, int retries) throws IOException, InterruptedException {
        return super.load(name, retries);
    }

    @Override
    public void close() {}

    class Entry {
        Entry(String key) {}
    }
}

enum Direction implements Supplier<String>, Comparable<Direction> {
    NORTH, SOUTH;

    public String get() { return name().toLowerCase(); }
}

/** Module descriptor (normally lives in module-info.java). */
open module shapes {
    requires transitive java.desktop;
    requires static lombok;
    exports com.example.shapes to com.example.app;
    opens com.example.shapes.internal;
    uses com.example.shapes.ShapeFactory;
    provides com.example.shapes.ShapeFactory with com.example.shapes.DefaultFactory;
}
