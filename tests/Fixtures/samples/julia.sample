module Geometry

using LinearAlgebra
using Statistics: mean, std
import Base: show, +, ==
import Random as Rng

export Point, Shape, area, centroid
public Circle

const ORIGIN_TOLERANCE = 1e-9
const MAX_ITERS = 0x00ff
const MASK = 0b1010_0101
const OCTAL = 0o755
const BIG = 1_000_000
global counter = 0

abstract type Shape end

"""
    Point{T<:Real}

A point in two dimensions.
"""
struct Point{T<:Real} <: Shape
    x::T
    y::T
end

mutable struct Circle{T} <: Shape where {T<:AbstractFloat}
    center::Point{T}
    radius::T
end

primitive type Flag8 8 end

Base.:+(a::Point, b::Point) = Point(a.x + b.x, a.y + b.y)
==(a::Point, b::Point) = a.x == b.x && a.y == b.y

area(c::Circle) = π * c.radius^2
area(::Shape) = nothing

function show(io::IO, p::Point{T}) where {T}
    print(io, "Point{$T}($(p.x), $(p.y))\n")
end

@doc """
    centroid(points)

Return the mean point of `points`.
""" ->
function centroid(points::Vector{<:Point})
    isempty(points) && return missing
    xs = [p.x for p in points]
    ys = [p.y for p in points if p isa Point]
    return Point(mean(xs), mean(ys))
end

macro debug(expr)
    return quote
        local value = $(esc(expr))
        println($(string(expr)), " = ", value)
        value
    end
end

end # module

