try
    open("data.csv") do io
        for (i, line) in enumerate(eachline(io))
            i > MAX_ITERS && break
            startswith(line, '#') && continue
            fields = split(line, r"\s*,\s*"i)
            m = match(r"""^(?<key>\w+)=(?<val>\d+)$"""x, line)
            m === nothing || println(m[:key])
        end
    end
catch err
    if err isa SystemError
        @warn "missing file" exception = err
    elseif err isa ArgumentError
        rethrow()
    else
        throw(ErrorException("unexpected: $err"))
    end
finally
    println(stderr, "done\t\u2713 \x41")
end

