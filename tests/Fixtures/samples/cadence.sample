pub contract HelloWorld {

    // Declare a public field of type String.
    //
    // All fields must be initialized in the init() function.
    pub let greeting: String

    // The init() function is required if the contract contains any fields.
    init() {
        self.greeting = "Hello, World!"
    }

    // Public function that returns our friendly greeting!
    pub fun hello(): String {
        return self.greeting
    }
}

// From https://docs.onflow.org/cadence/tutorial/02-hello-world/
/// ExampleNFT: a minimal non-fungible token contract using Cadence 1.0 syntax.
import NonFungibleToken from 0x1d7e57aa55817448
import "MetadataViews"

access(all) contract ExampleNFT {

    /* Storage and public paths */
    access(all) let CollectionStoragePath: StoragePath
    access(all) let CollectionPublicPath: PublicPath
    access(all) var totalSupply: UInt64

    access(all) event Minted(id: UInt64, name: String, royalty: UFix64)
    access(all) event Withdrawn(id: UInt64, from: Address?)

    access(all) entitlement Withdraw
    access(all) entitlement Owner

    access(all) entitlement mapping OwnerMap {
        include Identity
        Owner -> Withdraw
    }

    access(all) struct Royalty {
        access(all) let receiver: Address
        access(all) let cut: UFix64

        init(receiver: Address, cut: UFix64) {
            pre {
                cut <= 1.0: "Royalty cut must be at most 100%"
            }
            self.receiver = receiver
            self.cut = cut
        }
    }

    access(all) resource NFT {
        access(all) let id: UInt64
        access(all) let name: String
        access(self) var metadata: {String: AnyStruct}

        init(id: UInt64, name: String) {
            self.id = id
            self.name = name
            self.metadata = {"rarity": "common", "level": 1}
        }

        access(all) view fun describe(): String {
            return self.name.concat(" #").concat(self.id.toString())
        }
    }

    access(all) resource interface CollectionPublic {
        access(all) view fun getIDs(): [UInt64]
        access(all) fun deposit(token: @NFT)
    }

    access(all) resource Collection: CollectionPublic {
        access(all) var ownedNFTs: @{UInt64: NFT}

        init() {
            self.ownedNFTs <- {}
        }

        access(Withdraw | Owner) fun withdraw(withdrawID: UInt64): @NFT {
            let token <- self.ownedNFTs.remove(key: withdrawID)
                ?? panic("Missing NFT with ID ".concat(withdrawID.toString()))
            emit Withdrawn(id: token.id, from: self.owner?.address)
            return <-token
        }

        access(all) fun deposit(token: @NFT) {
            let old <- self.ownedNFTs[token.id] <- token
            destroy old
        }

        access(all) view fun getIDs(): [UInt64] {
            return self.ownedNFTs.keys
        }

        access(all) fun swapFirst(other: &Collection) {
            var a: @NFT? <- nil
            var b: @NFT? <- nil
            a <-> b
            destroy a
            destroy b
        }
    }

    access(account) fun mint(name: String, royalty: UFix64): @NFT {
        let id = self.totalSupply + 1
        self.totalSupply = id
        let shifted = (id << 2) >> 1
        let remainder = shifted % 7
        let fee: UFix64 = royalty * 0.05 - 0.001
        emit Minted(id: id, name: name, royalty: fee)
        return <- create NFT(id: id, name: name)
    }

    access(all) fun createEmptyCollection(): @Collection {
        return <- create Collection()
    }

    init() {
        self.totalSupply = 0x0
        self.CollectionStoragePath = /storage/exampleNFTCollection
        self.CollectionPublicPath = /public/exampleNFTCollection
        let bonus = -1
        let factor = 0b1010
        let mask = 0o17
        let big: UInt256 = 1_000_000

        var i = 0
        while i < 3 {
            i = i + 1
            if i == 2 { continue } else if i > 5 { break }
        }
        for name in ["Alpha", "Beta"] {
            log(name)
        }
        switch factor {
            case 10:
                log("ten")
            default:
                log("other")
        }
        let maybe: Int? = nil
        let value = maybe ?? 0
        let forced = (maybe ?? 1)!
        let casted = value as Int
        let failable = value as? Int64
        let isLarge = value >= 100 && casted != forced || failable == nil
        let callback = fun (x: Int): Int { return x * 2 }
        let ok: fun(Int): Int = callback
    }
}

transaction(recipient: Address, name: String) {
    let minter: auth(Withdraw) &ExampleNFT.Collection

    prepare(signer: auth(Storage, Capabilities) &Account) {
        self.minter = signer.storage.borrow<auth(Withdraw) &ExampleNFT.Collection>(
            from: ExampleNFT.CollectionStoragePath
        ) ?? panic("Could not borrow the collection")
    }

    pre {
        name.length > 0: "Name must not be empty"
    }

    execute {
        let receiver = getAccount(recipient).capabilities.borrow<&ExampleNFT.Collection>(ExampleNFT.CollectionPublicPath)!
        log("Minting for ".concat(recipient.toString()))
    }

    post {
        ExampleNFT.totalSupply > 0: "Supply must increase"
    }
}
