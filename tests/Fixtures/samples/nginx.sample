user       www www;  ## Default: nobody
worker_processes  5;  ## Default: 1
error_log  logs/error.log;
pid        logs/nginx.pid;
worker_rlimit_nofile 8192;

events {
  worker_connections  4096;  ## Default: 1024
}

http {
  include    conf/mime.types;
  include    /etc/nginx/proxy.conf;
  include    /etc/nginx/fastcgi.conf;
  index    index.html index.htm index.php;

  default_type application/octet-stream;
  log_format   main '$remote_addr - $remote_user [$time_local]  $status '
    '"$request" $body_bytes_sent "$http_referer" '
    '"$http_user_agent" "$http_x_forwarded_for"';
  access_log   logs/access.log  main;
  sendfile     on;
  tcp_nopush   on;
  server_names_hash_bucket_size 128; # this seems to be required for some vhosts

  server { # php/fastcgi
    listen       80;
    server_name  domain1.com www.domain1.com;
    access_log   logs/domain1.access.log  main;
    root         html;

    location ~ \.php$ {
      fastcgi_pass   127.0.0.1:1025;
    }
  }

  server { # simple reverse-proxy
    listen       80;
    server_name  domain2.com www.domain2.com;
    access_log   logs/domain2.access.log  main;

    # serve static files
    location ~ ^/(images|javascript|js|css|flash|media|static)/  {
      root    /var/www/virtual/big.server.com/htdocs;
      expires 30d;
    }

    # pass requests for dynamic content to rails/turbogears/zope, et al
    location / {
      proxy_pass      http://127.0.0.1:8080;
    }
  }

  upstream big_server_com {
    server 127.0.0.3:8000 weight=5;
    server 127.0.0.3:8001 weight=5;
    server 192.168.0.1:8000;
    server 192.168.0.1:8001;
  }

  server { # simple load balancing
    listen          80;
    server_name     big.server.com;
    access_log      logs/big.server.access.log main;

    location / {
      proxy_pass      http://big_server_com;
    }
  }
}

# From https://www.nginx.com/resources/wiki/start/topics/examples/full/

# --- Production config for an application server ---

load_module modules/ngx_http_js_module.so;

stream {
  upstream dns_servers {
    least_conn;
    server 10.0.0.53:53 max_fails=3 fail_timeout=30s;
  }
  server {
    listen 53 udp reuseport;
    proxy_pass dns_servers;
    proxy_timeout 2s;
    preread_timeout 5s;
  }
}

mail {
  server_name mail.example.com;
  auth_http   127.0.0.1:9000/auth;
  smtp_auth   login plain;
  imap_capabilities "IMAP4rev1" "UIDPLUS";
  pop3_auth   plain apop;
}

http {
  types {
    text/html  html htm;
    application/wasm wasm;
  }

  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

  map $request_uri $redirect_target {
    ~^/old/(?<slug>.+)$  /new/$slug;
    default              "";
  }

  geo $trusted_network {
    default        0;
    192.168.0.0/16 1;
  }

  limit_req_zone  $binary_remote_addr zone=api:10m rate=10r/s;
  limit_conn_zone $binary_remote_addr zone=perip:10m;
  client_max_body_size 25m;
  keepalive_timeout 65 60;
  gzip on;
  gzip_comp_level 5;
  gzip_types text/plain text/css application/json application/javascript;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256";
  add_header X-Frame-Options "SAMEORIGIN" always;
  open_file_cache max=1000 inactive=20s;
  proxy_cache_path /var/cache/nginx levels=1:2 keys_zone=app_cache:10m max_size=1g;

  server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name example.com *.example.com;
    ssl_certificate     /etc/ssl/certs/example.pem;
    ssl_certificate_key /etc/ssl/private/example.key;
    http2_chunk_size 8k;
    error_page 404 /404.html;
    error_page 500 502 503 504 /50x.html;

    if ($redirect_target != "") {
      return 301 https://$host${redirect_target};
    }

    if ($http_user_agent ~* "(curl|wget)") {
      return 403;
    }

    if (!-f $request_filename) {
      rewrite ^/blog/(\d{4})/(\d{2})/(.*)$ /blog.php?year=$1&month=$2&slug=$3 last;
    }

    location = /health {
      access_log off;
      default_type text/plain;
      return 200 "ok\n";
    }

    location ^~ /static/ {
      alias /srv/app/public/;
      expires max;
      autoindex_exact_size off;
      try_files $uri $uri/ =404;
    }

    location ~* \.(png|jpe?g|gif|svg|webp)$ {
      expires 7d;
      add_header Cache-Control "public, immutable";
    }

    location /api/ {
      limit_req zone=api burst=20 nodelay;
      limit_except GET POST {
        deny all;
      }
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_http_version 1.1;
      proxy_read_timeout 90s;
      proxy_cache app_cache;
      proxy_pass http://big_server_com;
    }

    location /internal/ {
      internal;
      auth_basic "Restricted";
      auth_basic_user_file /etc/nginx/.htpasswd;
      allow 10.0.0.0/8;
      deny  all;
    }

    location /lua {
      content_by_lua_block {
        ngx.say("Hello from Lua")
      }
    }

    location @fallback {
      proxy_pass http://127.0.0.1:3000;
    }
  }

  server {
    listen 80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
  }
}
