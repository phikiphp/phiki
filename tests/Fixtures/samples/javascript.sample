// --- JSX ---

function App({ user, items }) {
  const header = <h1 className="title" data-id='main'>Hello &amp; welcome &#169; &#x2014;</h1>;
  const empty = <></>;
  const ns = <svg:rect xlink:href="#a" />;
  return (
    <Layout.Main
      title="Home"
      {...props}
      onClick={() => setOpen(!open)}
      // a comment between attributes
      /* another */
      disabled
    >
      {user ? <Profile user={user} /> : <Login />}
      {items.map((item) => (
        <Item key={item.id} {...item} />
      ))}
      <>
        <span>{/* inline comment */}</span>
      </>
    </Layout.Main>
  );
}

// --- Flow / TypeScript-style annotations ---
// Many .js files are type-checked with Flow, and VS Code's JavaScript grammar
// still highlights these annotations.

type Id = string | number;
type Point = { x: number, y: number };
type Pair<T> = [first: T, second?: T, ...rest: T[]];
type Callback = (err: ?Error, value: any) => void;
type Ctor = new (value: string) => Object;
type GenericCtor = new <T>(value: T) => T;
type Keys = keyof Point;
type Mapped = { readonly [K in Keys as `get${K}`]+?: () => Point[K] };
type Unwrap<T> = T extends Promise<infer U extends object> ? U : never;
type Fn = <T>(arg: T) => T;
type Readonly = readonly string[];
type Nested = Map<string, Array<number>>;
type Qualified = React.Node;
type QualifiedGeneric = React.Element<typeof Widget>;
type Lazy = import("./module.js");
type Obj = {
  name: string,
  [key: string]: mixed,
  method(): void,
  ...Point,
};
type Union =
  | { kind: "a" }
  | { kind: "b" };
type Template = `prefix-${string}`;
type Intrinsic = intrinsic;
type Literals = true | null | undefined | this | object | bigint | symbol | unknown | boolean;
type Placeholder = Array<_>;

interface Shape extends Base.Item {
  area(): number;
}

