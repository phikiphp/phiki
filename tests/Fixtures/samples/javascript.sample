// Classes
class Counter extends EventTarget {
  #count = 0;
  static instances = 0;
  label = "counter";
  onClick = () => this.increment();
  handle = function () {};

  static {
    Counter.instances++;
  }

  constructor(start) {
    super();
    this.#count = start;
  }

  get value() {
    return this.#count;
  }

  set value(v) {
    this.#count = v;
  }

  *[Symbol.iterator]() {
    yield this.#count;
  }

  async increment() {
    this.#count += 1;
  }
}

const Anon = class {
