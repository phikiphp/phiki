console.log(Module.add(10, 20));  // 30

// --- Classes, private members and static blocks ---

export * from './shapes.js';
export { add as sum, person as personRecord } from './module.js';

@sealed
class Shape {
  static #count = 0;
  #id;
  name = 'shape';

  static {
    Shape.registry = new Map();
  }

  constructor(name) {
    this.#id = ++Shape.#count;
    this.name = name ?? this.name;
    if (new.target === Shape) throw new TypeError(`Shape is abstract`);
  }

  get id() { return this.#id; }
  set label(value) { this.name = String(value).trim(); }
  static create(...args) { return Reflect.construct(this, args); }
  #secret() { return #id in this; }
  async *[Symbol.asyncIterator]() { yield* [1, 2, 3]; }
  toString() { return `${this.constructor.name}(${this.name})`; }
}

class Circle extends Shape {
  constructor(radius = 1) {
    super('circle');
    this.radius = radius;
  }
  get area() { return Math.PI * this.radius ** 2; }
}

