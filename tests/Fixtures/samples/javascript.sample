abstract class Repository<T> implements Store<T>, Base.Iterable {
  private readonly items: T[] = [];
  protected static count?: number;
  declare name: string;
  public optional?: string;
  definite!: number;
  override accessor size = 0;
  abstract find(id: Id): T;
  get?(): void;

  constructor(private readonly db: Database, public override name: string) {
    super();
  }

  public async save<K extends keyof T>(item: T, key: K): Promise<void> {}
  [key: string]: any;
}

const Klass = abstract class {};
class Impl implements Repository.Base<T> {}
