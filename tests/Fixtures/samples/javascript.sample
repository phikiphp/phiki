void 0, delete car.model, typeof undefined === 'undefined';

// --- Destructuring, spread and control flow ---

const { name: shapeName = 'none', ...restProps } = new Circle(3);
const [first, , third = 0, ...others] = [1, 2, 3, 4, 5];
const merged = { ...car, ['computed' + key]: true, method() { return this; }, get size() { return 1; } };

outer: for (let i = 0; i < 3; i++) {
  for (let j = 0; j < 3; j += 1) {
    if (j === 1) continue outer;
    if (i > 1) break outer;
  }
}

let attempts = 0;
do {
  attempts--;
} while (attempts > -3);

switch (typeof merged) {
  case 'object':
    console.info('object');
    break;
  case 'function':
  default:
    console.warn('unexpected');
