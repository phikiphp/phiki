const load = async () => {
  const { default: lodash } = await import('lodash');
  for await (const chunk of stream) process(chunk);
  const results = await Promise.allSettled([fetch('/a'), fetch('/b')]);
  return results.filter(({ status }) => status === 'fulfilled');
};

