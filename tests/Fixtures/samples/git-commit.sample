diff --git a/src/Pagination/Paginator.php b/src/Pagination/Paginator.php
index 3f2a9c1..b7e04d2 100644
--- a/src/Pagination/Paginator.php
+++ b/src/Pagination/Paginator.php
@@ -41,7 +41,11 @@ final class Paginator
     public function pageCount(): int
     {
-        return intdiv($this->total, $this->perPage) + 1;
+        if ($this->total === 0) {
+            return 0;
+        }
+
+        return intdiv($this->total + $this->perPage - 1, $this->perPage);
     }
 
     public function hasMorePages(): bool
