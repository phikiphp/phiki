      ******************************************************************
      * Author: Bryan Flood
      * Date: 25/10/2018
      * Purpose: Compute Fibonacci Numbers
      * Tectonics: cobc
      ******************************************************************
       IDENTIFICATION DIVISION.
       PROGRAM-ID. FIB.
       DATA DIVISION.
       FILE SECTION.
       WORKING-STORAGE SECTION.
       01  N0             BINARY-C-LONG VALUE 0.
       01  N1             BINARY-C-LONG VALUE 1.
       01  SWAP           BINARY-C-LONG VALUE 1.
       01  RESULT         PIC Z(20)9.
       01  I              BINARY-C-LONG VALUE 0.
       01  I-MAX          BINARY-C-LONG VALUE 0.
       01  LARGEST-N      BINARY-C-LONG VALUE 92.

       PROCEDURE DIVISION.
      *>  THIS IS WHERE THE LABELS GET CALLED
           PERFORM MAIN
           PERFORM ENDFIB
           GOBACK.

      *>  THIS ACCEPTS INPUT AND DETERMINES THE OUTPUT USING A EVAL STMT
       MAIN.
            DISPLAY "ENTER N TO GENERATE THE FIBONACCI SEQUENCE"
            ACCEPT I-MAX.

            EVALUATE TRUE
              WHEN I-MAX > LARGEST-N
                 PERFORM INVALIDN

              WHEN I-MAX > 2
                 PERFORM CASEGREATERTHAN2

              WHEN I-MAX = 2
                 PERFORM CASE2

              WHEN I-MAX = 1
                 PERFORM CASE1

              WHEN I-MAX = 0
                 PERFORM CASE0

              WHEN OTHER
                 PERFORM INVALIDN

            END-EVALUATE.

            STOP RUN.



       *>  THE CASE FOR WHEN N = 0
       CASE0.
           MOVE N0 TO RESULT.
           DISPLAY RESULT.

      *>  THE CASE FOR WHEN N = 1
       CASE1.
           PERFORM CASE0
           MOVE N1 TO RESULT.
           DISPLAY RESULT.

      *>  THE CASE FOR WHEN N = 2
       CASE2.
           PERFORM CASE1
           MOVE N1 TO RESULT.
           DISPLAY RESULT.

      *>  THE CASE FOR WHEN N > 2
       CASEGREATERTHAN2.
           PERFORM CASE1
           PERFORM VARYING I FROM 1 BY 1 UNTIL I = I-MAX
                   ADD N0 TO N1 GIVING SWAP
                   MOVE N1 TO N0
                   MOVE SWAP TO N1
                   MOVE SWAP TO RESULT
                   DISPLAY RESULT
            END-PERFORM.

      *>  PROVIDE ERROR FOR INVALID INPUT
       INVALIDN.
           DISPLAY 'INVALID N VALUE. THE PROGRAM WILL NOW END'.

      *>  END THE PROGRAM WITH A MESSAGE
       ENDFIB.
           DISPLAY "THE PROGRAM HAS COMPLETED AND WILL NOW END".

       END PROGRAM FIB.

*> From https://github.com/KnowledgePending/COBOL-Fibonacci-Sequence/blob/master/fib.cbl

      $SET SOURCEFORMAT"FIXED"
      >>SOURCE FORMAT IS FIXED
000100 IDENTIFICATION DIVISION.
000200 PROGRAM-ID. PAYROLL.
000300 AUTHOR. ACCOUNTING SYSTEMS TEAM.
000400 DATE-WRITTEN. 2026-11-03.
000500*----------------------------------------------------------------
000600* MONTHLY PAYROLL: READS EMPLOYEES, UPDATES DB2 AND PRINTS TOTALS
000700*----------------------------------------------------------------
000800 ENVIRONMENT DIVISION.
000900 CONFIGURATION SECTION.
001000 SOURCE-COMPUTER. IBM-Z15.
001100 INPUT-OUTPUT SECTION.
001200 FILE-CONTROL.
001300     SELECT EMPLOYEE-FILE ASSIGN TO EMPFILE
001400         ORGANIZATION IS INDEXED
001500         ACCESS MODE IS DYNAMIC
001600         RECORD KEY IS EMP-ID
001700         FILE STATUS IS WS-FILE-STATUS.
001800 DATA DIVISION.
001900 FILE SECTION.
002000 FD  EMPLOYEE-FILE.
002100 01  EMPLOYEE-RECORD.
002200     05  EMP-ID              PIC 9(6).
002300     05  EMP-NAME            PIC X(30).
002400     05  EMP-SALARY          PIC S9(7)V99 COMP-3.
002500     05  EMP-RATE            PIC 9V9(4).
002600     05  FILLER              PIC X(10).
002700 WORKING-STORAGE SECTION.
002800 78  MAX-EMPLOYEES           VALUE 500.
002900 01  WS-FILE-STATUS          PIC XX VALUE SPACES.
003000     88  WS-EOF              VALUE "10".
003100     88  WS-OK               VALUE "00".
003200 01  WS-TOTALS.
003300     05  WS-GROSS            PIC S9(9)V99 COMP-3 VALUE ZEROES.
003400     05  WS-COUNT            BINARY-LONG VALUE 0.
003500     05  WS-TAX-RATE         COMP-2 VALUE 0.215.
003600 01  WS-REPORT-LINE          PIC $$$,$$$,$$9.99-.
003700 01  WS-TODAY                PIC 9(8).
003800 01  WS-MASK                 PIC X(4) VALUE X"0D0A0000".
003900 01  WS-FLAG                 PIC 1 VALUE B"1".
004000 01  WS-NATIONAL             PIC N(12) VALUE N"GROSS TOTAL".
004100 01  WS-TABLE.
004200     05  WS-ENTRY OCCURS 12 TIMES INDEXED BY WS-IDX.
004300         10  WS-MONTH        PIC X(3).
004400         10  WS-AMOUNT       PIC 9(7)V99.
004500     EXEC SQL INCLUDE SQLCA END-EXEC.
004600 PROCEDURE DIVISION.
004700 MAIN-PARA.
004800     MOVE FUNCTION CURRENT-DATE(1:8) TO WS-TODAY
004900     OPEN INPUT EMPLOYEE-FILE
005000     PERFORM UNTIL WS-EOF
005100         READ EMPLOYEE-FILE NEXT RECORD
005200             AT END SET WS-EOF TO TRUE
005300             NOT AT END PERFORM PROCESS-EMPLOYEE
005400         END-READ
005500     END-PERFORM
005600     CLOSE EMPLOYEE-FILE
005700     COMPUTE WS-GROSS ROUNDED = WS-GROSS * (1 - WS-TAX-RATE)
005800         ON SIZE ERROR DISPLAY "OVERFLOW IN GROSS" UPON SYSERR
005900     END-COMPUTE
006000     MOVE WS-GROSS TO WS-REPORT-LINE
006100     DISPLAY "TOTAL: " WS-REPORT-LINE " FOR " WS-COUNT " STAFF"
006200     IF WS-COUNT > MAX-EMPLOYEES OR WS-COUNT = ZERO
006300         DISPLAY 'UNEXPECTED NUMBER OF EMPLOYEES' UPON CONSOLE
006400     ELSE
006500         CALL "CBL_CHECK_FILE_EXIST" USING BY REFERENCE EMP-NAME
006600                                            BY VALUE WS-COUNT
006700     END-IF
006800     GOBACK.
006900 PROCESS-EMPLOYEE.
007000     ADD 1 TO WS-COUNT
007100     ADD EMP-SALARY TO WS-GROSS
007200     INSPECT EMP-NAME REPLACING ALL LOW-VALUES BY SPACES
007300     STRING EMP-NAME DELIMITED BY SIZE
007400            " (" DELIMITED BY SIZE
007500            EMP-ID DELIMITED BY SIZE
007600            ")" DELIMITED BY SIZE
007700         INTO WS-MONTH(1)
007800     END-STRING
007900     EXEC SQL
008000         UPDATE PAYROLL.EMPLOYEE
008100            SET SALARY = :EMP-SALARY  -- Monthly salary
008200          WHERE EMP_ID = :EMP-ID
008300     END-EXEC
008400     IF SQLCODE NOT = 0
008500         DISPLAY "SQL ERROR " SQLCODE
008600     END-IF
008700     EXEC CICS WRITEQ TS QUEUE('PAYQ')
008800          FROM(EMPLOYEE-RECORD) LENGTH(LENGTH OF EMPLOYEE-RECORD)
008900          RESP(WS-COUNT)
009000     END-EXEC
009100     IF WS-COUNT NOT = DFHRESP(NORMAL)
009200         DISPLAY "CICS WRITE FAILED"
009300     END-IF.
009400 END PROGRAM PAYROLL.

      *> Object-oriented COBOL: a small class with a method
      $set ilusing"System.Text"
      $region Accumulator class
       CLASS-ID. Accumulator INHERITS Base.
       FACTORY.
       END FACTORY.
       OBJECT.
       WORKING-STORAGE SECTION.
       01  total               PIC S9(9) COMP-5 VALUE 0.
       01  label-text          string value u"Running total".
       01  c-name              PIC X(16) VALUE Z"accumulator".
       METHOD-ID. AddValue public.
       LINKAGE SECTION.
       01  amount              PIC S9(9) COMP-5.
       PROCEDURE DIVISION USING BY VALUE amount.
           ADD amount TO total
      *> @param amount value added to the running total
           TRY
               INVOKE SELF "Log" USING total
           CATCH ex
               DISPLAY "LOGGING FAILED: " ex::Message
           FINALLY
               CONTINUE
           END-TRY
           JSON GENERATE WS-JSON FROM total COUNT IN WS-LEN
               NAME OF total IS "runningTotal"
           END-JSON
      >>IF DEBUG-MODE DEFINED
           DISPLAY "TOTAL NOW " total UPON SYSOUT
      >>END-IF
           GOBACK.
       END METHOD AddValue.
       END OBJECT.
       END CLASS Accumulator.
      $end-region
