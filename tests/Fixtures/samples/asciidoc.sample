[[configuration]]
== Configuration

.Example `config.yaml`
[source,yaml]
----
server:
  port: 8080 # <1>
  host: "0.0.0.0"
database:
  url: postgres://localhost/orbit
----

<1> The HTTP port the service listens on.

[source,java]
----
public final class Main {
    public static void main(String[] args) {
        System.out.println("Starting " + args.length); // <2>
    }
}
----

<2> Prints the argument count.

[source,sql]
----
SELECT id, name FROM users WHERE active = true ORDER BY name;
----

```ruby
puts "Fenced code blocks work too"
```

[source,javascript]
----
const res = await fetch(`/api/health`);
console.log(res.ok ? 'up' : 'down');
----

[source,css]
--
.banner { color: #333; margin: 0 auto; }
--

[source,dockerfile]
----
FROM eclipse-temurin:21-jre
COPY build/orbit.jar /app/orbit.jar
ENTRYPOINT ["java", "-jar", "/app/orbit.jar"]
----

