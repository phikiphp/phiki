## Define the service name in a variable
$ServiceName = 'EventLog'

## Read the service from Windows to return a service object
$ServiceInfo = Get-Service -Name $ServiceName

## If the server is not running (ne)
if ($ServiceInfo.Status -ne 'Running') {
	## Write to the console that the service is not running
	Write-Host 'Service is not started, starting service'
	## Start the service
	Start-Service -Name $ServiceName
	## Update the $ServiceInfo object to reflect the new state
	$ServiceInfo.Refresh()
	## Write to the console the Status property which indicates the state of the service
	Write-Host $ServiceInfo.Status
} else { ## If the Status is anything but Running
	## Write to the console the service is already running
	Write-Host 'The service is already running.'
}

## From https://adamtheautomator.com/powershell-script-examples/

#Requires -Version 7.0
using namespace System.Collections.Generic

<#
.SYNOPSIS
    Collects disk usage for a set of folders and writes a report.
.DESCRIPTION
    Demonstrates functions, classes, pipelines and string handling.
.PARAMETER Path
    One or more folders to measure.
.EXAMPLE
    Get-FolderSize -Path C:\Temp, C:\Logs -Recurse
#>

enum SizeUnit {
    Bytes = 1
    KB    = 1024
    MB    = 1048576
}

class FolderReport {
    [string] $Path
    [long] $Bytes
    hidden [datetime] $Created = [datetime]::Now
    static [int] $Count = 0

    FolderReport([string] $path, [long] $bytes) {
        $this.Path = $path
        $this.Bytes = $bytes
        [FolderReport]::Count++
    }

    [double] ToUnit([SizeUnit] $unit) {
        return [math]::Round($this.Bytes / [int]$unit, 2)
    }

    [string] ToString() {
        return "{0,-30} {1,10:N2} MB" -f $this.Path, $this.ToUnit([SizeUnit]::MB)
    }
}

function Get-FolderSize {
    [CmdletBinding(SupportsShouldProcess = $true)]
    [OutputType([FolderReport])]
    param (
        [Parameter(Mandatory, ValueFromPipeline, Position = 0)]
        [ValidateNotNullOrEmpty()]
        [string[]] $Path,

        [switch] $Recurse,

        [ValidateRange(1, 100)]
        [int] $Top = 10
    )

    begin {
        $results = [List[FolderReport]]::new()
        $ErrorActionPreference = 'Stop'
    }
    process {
        foreach ($folder in $Path) {
            if (-not (Test-Path -LiteralPath $folder -PathType Container)) {
                Write-Warning "Skipping '$folder': not a directory"
                continue
            }
            try {
                $bytes = (Get-ChildItem -Path $folder -File -Recurse:$Recurse |
                    Measure-Object -Property Length -Sum).Sum
                $results.Add([FolderReport]::new($folder, [long]$bytes))
            }
            catch [System.UnauthorizedAccessException] {
                Write-Error "Access denied for $($folder): $($_.Exception.Message)"
            }
            finally {
                Write-Verbose "Measured $folder at $(Get-Date -Format 'HH:mm:ss')"
            }
        }
    }
    end {
        $results | Sort-Object -Property Bytes -Descending | Select-Object -First $Top
    }
}

$limits = @{
    Warning  = 0x400
    Critical = 2GB
    Ratio    = 1.5e3
    Enabled  = $true
}
$folders = @('C:\Temp', "$env:USERPROFILE\Downloads", $HOME)
$report = $folders | Get-FolderSize -Recurse -Top 5 -Verbose

switch -Regex ($report.Count) {
    '^0$'   { Write-Host 'No folders measured' -ForegroundColor Yellow; break }
    '^\d$'  { Write-Host "Measured $_ folders" }
    default { Write-Host 'Lots of folders' }
}

$big = $report.Where({ $_.Bytes -gt $limits.Critical })
$names = $report | ForEach-Object { $_.Path.ToUpper() } | Where-Object { $_ -like '*TEMP*' -or $_ -match '^C:' }
$i = 0
while ($i -lt 3) { $i += 1 }
do { $i-- } until ($i -le 0)
for ($n = 0; $n -lt 10; $n++) { if ($n % 2 -eq 0) { continue } }
$total = ($report | Measure-Object -Property Bytes -Sum).Sum ?? 0
$label = $total -ge 1MB ? 'large' : 'small'
$here = @"
Report generated by $env:USERNAME on $(Get-Date)
Total bytes: $total `t(tab) `n
"@
$literal = @'
No $expansion in here.
'@
$script = { param($x) $x * 2 }
& $script 21
. .\helpers.ps1
$report | Export-Csv -Path .\report.csv -NoTypeInformation 2>&1 > $null
[void][System.Reflection.Assembly]::LoadWithPartialName('System.Web')
$splat = @{ Path = '.\out.txt'; Encoding = 'utf8' }
Set-Content @splat -Value ($names -join ', ')
trap { Write-Error $_; exit 1 }
throw [System.IO.FileNotFoundException]::new('missing.txt')
