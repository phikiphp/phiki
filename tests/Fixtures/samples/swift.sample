func builtins(numbers: [Int], dict: [String: Int?], flag: ImplicitlyUnwrappedOptional<Int>) {
    let args = CommandLine.arguments
    let argc = Process.argc
    let mirror = Mirror(reflecting: numbers)
    let anyGen = AnyGenerator { nil }
    let never: Never? = nil
    let word: Word = 0
    var gen: GeneratorType? = nil
    let rev: ReverseCollection<[Int]>? = nil
    let buffer: ManagedBuffer<Int, Int>? = nil
    autoreleasepool {
        print(args, argc, mirror.superclassMirror, anyGen, never as Any, word, gen as Any, rev as Any, buffer as Any)
    }
    gen = nil
    let ok = flag.boolValue
    let s = "abc".startsWith("a")
    sort(&numbers)
    let dist = distance(numbers.startIndex, numbers.endIndex)
    let (value, code) = #stringify(1 + 2)
    let color = #colorLiteral(red: 1, green: 0, blue: 0, alpha: 1)
    let image = #imageLiteral(resourceName: "icon")
    let path = #keyPath(LegacyBridge.title)
    let action = #selector(getter: LegacyBridge.title)
    let tap = #selector(LegacyBridge.refresh)
    let name = perform(_:with:)
    let first = numbers.0
    print(ok, s, dist, value, code, color, image, path, action, tap, name, first)
}

func moreNumbers() {
    let hexFloat = 0xFFp-2
    let weirdHex = 0x1.5abc // invalid: hex fraction needs an exponent
    let leadingDot = .5
    let badPrefix = 0x_FF // invalid: separator right after the prefix
    let badDecimal = 1abc // invalid digits
    let pair = (1, 2)
    let second = pair.1
    print(hexFloat, weirdHex, leadingDot, badPrefix, badDecimal, second)
}

func moreStrings(name: String) {
    let raw = #"""
        Raw multi-line with \#(name) and \#n and \#u{1F600} \#q
        "quoted" \(not interpolated)
        """#
    let rawer = ##"""
        Two hashes: \##(name)
        """##
    let hashed = ##"She said "#hi"# \##t"##
    let escapes = "Bad \q escape and nested \(name.map { "(\($0))" }.joined())"
    // Invalid: single-line string literals may not contain a line break.
    let unterminated = "missing end
    "
    let rawOpen = #"also missing
    "#
    let doubleOpen = ##"double missing
    "##
    print(raw, rawer, hashed, escapes, unterminated, rawOpen, doubleOpen)
}

func regexes() {
    let simple = /\d+(?:\.\d+)?/
    let flags = #/(?i)hello|(?-i:WORLD)|(?^x)/#
    let refs = #/(?<y>\d{4})-\k<y>-\k{y}-\g{1}-\g-1-\g<y>-\k'y'-\g'1'-\12-(?P=y)-(?&y)-(?R)-(?1)/#
    let props = #/\p{Letter}\P{Nd}[[:alpha:]][a-z&&[^aeiou]][a-z--[q]][a~~b][\b]/#
    let scalars = #/\u{1F600}\u0041\x{41}\x41\U0001F600\o{101}\0101\N{U+41}\N{LATIN SMALL LETTER A}/#
    let misc = #/\Qa.b\E\cA\e(?#comment)(?~abc)(?(1)yes|no)(?(<y>)a|b)(*ACCEPT)(*LIMIT_DEPTH=10)(*UTF)(?C1)(?C"text")(*name[tag]{a,b})(?{code})/#
    let extended = #/
        (?<year> \d{4} ) - (?<month> \d{2} )   # date
        \Q literal \E
        (?#comment)
        <{ interpolation }>
        /#
    print(simple, flags, refs, props, scalars, misc, extended)
}

func operatorsDemo(a: inout Int, b: Int, c: Int?) {
    a += 1; a -= 1; a *= 2; a /= 2; a %= 3
    a <<= 1; a >>= 1; a &= 1; a |= 2; a ^= 3
    let sum = a + b - a * b / 2 % 5
    let overflow = a &+ b &- b &* 1
    let compare = a == b || a != b && a > b || a < b || a >= b || a <= b
    let nilc = c ?? 0
    let bits = a & b | a ^ b << 1 >> 1
    let identity = (a as AnyObject) === (b as AnyObject) || (a as AnyObject) !== (b as AnyObject)
    let ternary = compare ? sum : nilc
    let neg = -a, pos = +a, inv = ~a, not = !compare
    let range = ..<5, from = 2..., through = ...10
    let slice = [1, 2, 3][1...]
    let custom = a <~> b
    let post = a^^
    let matched = 5 ~= 1
    print(overflow, bits, identity, ternary, neg, pos, inv, not, range, from, through, slice, custom, post, matched)
}

