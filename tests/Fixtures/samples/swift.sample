protocol Shape: AnyObject {
    init?(json: [String: Any])
    func area() -> Double
}

protocol Drawable: class {}

final class Circle: Shape {
    let radius: Double
    required init?(json: [String: Any]) {
        guard let r = json["radius"] as? Double else { return nil }
        radius = r
    }
    init!(unsafe radius: Double) { self.radius = radius }
    convenience init?!() { self.init(unsafe: 1) } // invalid: only one of ? or !
    func area() -> Double { .pi * radius * radius }
}

func makeShapes() -> some Collection<any Shape> { [Circle]() }

func variadic(_ values: Int...) -> Int { values.reduce(0, +) }

func tuple<each T>(_ value: repeat each T) -> (repeat each T) { (repeat each value) }

