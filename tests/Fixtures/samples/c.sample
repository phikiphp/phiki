/*
 * Conditional directives that straddle a parenthesized expression or a switch
 * body are valid C, but the grammar cannot pair them with their #if (it sees
 * both branches), so this function is kept at the very end of the file.
 */
static int classify(const ring_buffer_t *rb, int value)
{
	if (rb->head == rb->tail
#ifdef RB_STRICT
	    && (rb->overflow == 0
#else
	    && (rb->overflow != 0
#endif
	    || value == 0))
		return 1;
#ifdef RB_STRICT
	switch (value) {
#else
	switch (value & 0xF) {
#endif
	case 0:
		return 0;
	default:
		break;
	}
	return -1;
}
