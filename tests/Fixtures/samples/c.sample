/* header guard */ #define CRC_POLY 0xEDB88320u /* reflected **/

static inline uint32_t crc_update(uint32_t crc, const uint8_t *restrict data, size_t len)
{
	int notify_progress(size_t done);
	uint32_t c = ~crc;
#if 1
	const int unrolled = 1;
#elif CRC_UNROLL
	disabled
#elif 0
	disabled too
#else
	disabled else
#endif
#if 0
	disabled in block
#elif 1
	const int via_elif = 1;
#elif CRC_OTHER
	disabled
#else
	disabled
#endif
#if 0
	disabled in block
#elif CRC_DYNAMIC
	const int dynamic = 1;
#else
	const int fixed = 1;
#endif
#ifdef CRC_TRACE
	LOG("crc_update(%u, %p, %zu)", crc, (const void *)data, len);
#elif 0
	disabled
#elif CRC_QUIET
	(void)0;
#else
	(void)len;
#endif

	for (size_t i = 0; i < len; i++) {
		c = sCrcTable[(c ^ data[i]) & 0xFF] ^ (c >> 8);
		crc_ctx->stats.bytes += 1;
		crc_ctx->ops->progress(crc_ctx, i);
		if (i % 4096 == 0 && notify_progress(i) != 0)
			break;
	}

	switch /* dispatch **/ (len /* bytes **/ & 3) {
	/* none **/ case 0:
		break;
	case 1: /* fall through */
	/* other **/ default:
		c = (len > 0 ? c : 0);
		break;
	} ;

	__asm__ volatile ("rev %0, %1\n\t" : "=r"(c) : [/* in **/ crc /* reg **/] "r"(c) : "memory");
	__asm__ volatile
		("dmb ish" : : : "memory");
	__asm__
	/* compiler barrier **/
	/* no operands **/ ("" ::: "memory");

	return ~c;
}

