//! Crate-level docs for a tiny inventory module.

#![allow(dead_code)]

extern crate alloc;

use std::collections::HashMap;
use std::fmt::{self, Display};

/// Maximum number of items a shelf can hold.
const MAX_ITEMS: usize = 0x1_00;
static FLAGS: u8 = 0b1010_0101u8;
const PERMS: u32 = 0o755;
const RATIO: f64 = 1.5e-3;

/* A plain block comment */
