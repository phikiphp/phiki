type MyError struct{ Code int }

func (e *MyError) Error() string { return fmt.Sprint(e.Code) }

func (Point) String() string { return "" }

func (t *Tree[T]) Walk(visit func(T)) {
	if t == nil {
		return
	}
	t.Left.Walk(visit)
	visit(t.Value)
}

